# /etc/claude-bugfix/config.env  (read by systemd and by the scripts)
# HOOK_URL stays 127.0.0.1:47613: after the cut-over the QA panel (kora-qa-panel) answers there instead of communitybot.
RES_DIR="/home/DevTestingKora/kora/server/txData/kora dev/resources"
HOOK_URL="http://127.0.0.1:47613"
FIX_ROOT="/var/lib/claude-bugfix"
CLAUDE_BIN="/var/lib/claude-bugfix/.local/bin/claude"

# QA panel cut-over (PLAN-kora_qa.md §7): Sonnet at medium effort for every step, final cycle 3.
TRIAGE_MODEL="claude-sonnet-5-5"
SIMPLE_MODEL="claude-sonnet-5-5"
FIX_MODEL="claude-sonnet-5-5"
ESCALATE_MODEL="claude-sonnet-5-5"
FINAL_MODEL="claude-sonnet-5-5"
# Fix cycle FINAL_CYCLE runs FINAL_MODEL at FINAL_EFFORT (the panel sets needs_manual_review after 3 Not fixed).
FINAL_CYCLE=3

# Thread statuses the fixer picks up. reopen re-runs a thread it already handled.
CANDIDATE_STATUSES="open,confirmed,reopen"

MAX_BUGS_PER_RUN=5
MAX_RESOURCES_PER_BUG=3
MAX_PATCH_LINES=600
MAX_FAILED_ATTEMPTS=2

# Per-session caps (client-side estimates).
BUDGET_TRIAGE_USD=0.50
BUDGET_FIX_USD=3
BUDGET_ESCALATE_USD=8

# Keep in step with fivem.protectedResources in communitybot's config (until the cut-over) and the panel's PROTECTED_RESOURCES.
# kora_qa: the QA runner itself; changes to it are made by hand (the panel never restarts it either). kora_lib/kora_core stay fixable.
PROTECTED_RESOURCES="monitor,kora_qa"

# Syntax checker for Lua (apt install lua5.4). Optional.
LUAC="luac5.4"

# 1 = do everything except post statuses (use for the first runs).
DRY_RUN=0

# Reasoning effort (low|medium|high); reopened/Not fixed threads go straight to ESCALATE_MODEL at ESCALATE_EFFORT.
TRIAGE_EFFORT="medium"
SIMPLE_EFFORT="medium"
FIX_EFFORT="medium"
ESCALATE_EFFORT="medium"
FINAL_EFFORT="medium"
# 1 = use the efforts above even when triage picks another one (bugfix.sh from kora-qa-panel/deploy/fixer).
IGNORE_TRIAGE_EFFORT=1
