{
  "about": "Shared argument-validation vectors for kora_qa/shared/catalog.lua (C.validateArgs) and the panel (server/scenarios/rules.js validateArgs). Each case: arg specs + values, run with env (caps/aliases/resource, optionally overridden per case). ok=false cases give the exact error; ok=true cases may give params (null fields ignored). Both sides must agree.",
  "version": 1,
  "env": {
    "resource": "kora_fishing",
    "caps": {
      "maxItemCount": 50, "maxMoney": 100000, "maxEntities": 6, "maxWaitSeconds": 120,
      "itemDeny": ["weapon_rpg"], "modelDeny": ["rhino", "hydra"], "allowCommands": [],
      "accounts": ["cash", "bank", "crypto"], "metadataDeny": ["citizenid"],
      "weather": ["CLEAR", "RAIN"], "inventoryTypes": ["player", "trunk"]
    },
    "aliases": {
      "kora_qa": { "locations": { "legion": { "x": 195.2, "y": -933.8, "z": 30.7, "h": 144 } }, "vehicles": { "cop": "police" } },
      "kora_fishing": {
        "locations": { "pier": { "x": -1850.5, "y": -1231.2, "z": 13, "h": 90, "r": 6 }, "list": [1, 2, 3] },
        "vehicles": { "boat": "dinghy", "tank": "rhino", "tbl": { "model": "Sultan" } },
        "fixtures": { "ready": { "steps": [ { "step": "items.have", "args": [1, "fishingrod"] } ] } }
      },
      "kora_hud": { "locations": { "hq": { "x": 1, "y": 2, "z": 3 } } }
    }
  },
  "cases": [
    { "name": "item ok, lowercased", "specs": [{ "name": "count", "type": "int", "cap": "maxItemCount", "min": 1 }, { "name": "item", "type": "string", "allow": "items" }], "values": [3, "Water"], "ok": true, "params": { "count": 3, "item": "water" } },
    { "name": "item over cap", "specs": [{ "name": "count", "type": "int", "cap": "maxItemCount", "min": 1 }], "values": [51], "ok": false, "error": "\"51\" (count) is over the maxItemCount cap (50)" },
    { "name": "under -cap", "specs": [{ "name": "delta", "type": "int", "cap": "maxItemCount" }], "values": [-51], "ok": false, "error": "\"-51\" (delta) is under the maxItemCount cap (-50)" },
    { "name": "below min", "specs": [{ "name": "count", "type": "int", "min": 1 }], "values": [0], "ok": false, "error": "\"0\" (count) must be at least 1" },
    { "name": "above max", "specs": [{ "name": "grade", "type": "int", "max": 20 }], "values": [21], "ok": false, "error": "\"21\" (grade) must be at most 20" },
    { "name": "cap not configured", "specs": [{ "name": "n", "type": "int", "cap": "maxUnknown" }], "values": [1], "ok": false, "error": "cap maxUnknown is not configured" },
    { "name": "int must be whole", "specs": [{ "name": "count", "type": "int" }], "values": [1.5], "ok": false, "error": "\"1.5\" (count) must be a whole number" },
    { "name": "float ok", "specs": [{ "name": "x", "type": "float", "min": -10000, "max": 10000 }], "values": [-12.5], "ok": true, "params": { "x": -12.5 } },
    { "name": "text must be text", "specs": [{ "name": "item", "type": "string" }], "values": [5], "ok": false, "error": "\"5\" (item) must be text" },
    { "name": "string default maxLength 200", "specs": [{ "name": "t", "type": "string" }], "values": ["xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"], "ok": false, "error": "t is longer than 200 characters" },
    { "name": "explicit maxLength", "specs": [{ "name": "value", "type": "string", "maxLength": 3 }], "values": ["abcd"], "ok": false, "error": "value is longer than 3 characters" },
    { "name": "word one word", "specs": [{ "name": "account", "type": "word" }], "values": ["two words"], "ok": false, "error": "\"two words\" (account) must be one word" },
    { "name": "item bad name", "specs": [{ "name": "item", "type": "string", "allow": "items" }], "values": ["bad item!"], "ok": false, "error": "\"bad item!\" (item) is not an item name" },
    { "name": "item denylist case-insensitive", "specs": [{ "name": "item", "type": "string", "allow": "items" }], "values": ["WEAPON_RPG"], "ok": false, "error": "\"WEAPON_RPG\" (item) is on the item denylist" },
    { "name": "item allowlist", "caps": { "itemAllow": ["water"] }, "specs": [{ "name": "item", "type": "string", "allow": "items" }], "values": ["bread"], "ok": false, "error": "\"bread\" (item) is not on the item allowlist" },
    { "name": "item allowlist hit", "caps": { "itemAllow": ["water"] }, "specs": [{ "name": "item", "type": "string", "allow": "items" }], "values": ["Water"], "ok": true, "params": { "item": "water" } },
    { "name": "account ok", "specs": [{ "name": "account", "type": "word", "allow": "accounts" }], "values": ["Bank"], "ok": true, "params": { "account": "bank" } },
    { "name": "account not allowed", "specs": [{ "name": "account", "type": "word", "allow": "accounts" }], "values": ["gold"], "ok": false, "error": "\"gold\" (account) is not an allowed money account" },
    { "name": "accounts default cash,bank", "capsUnset": ["accounts"], "specs": [{ "name": "account", "type": "word", "allow": "accounts" }], "values": ["crypto"], "ok": false, "error": "\"crypto\" (account) is not an allowed money account" },
    { "name": "job identifier", "specs": [{ "name": "job", "type": "string", "allow": "jobs" }], "values": ["Police"], "ok": true, "params": { "job": "police" } },
    { "name": "gang bad", "specs": [{ "name": "gang", "type": "string", "allow": "gangs" }], "values": ["the lost"], "ok": false, "error": "\"the lost\" (gang) is not a valid name" },
    { "name": "metadata deny", "specs": [{ "name": "key", "type": "string", "allow": "metadataKeys" }], "values": ["CitizenID"], "ok": false, "error": "\"CitizenID\" (key) is on the metadata denylist" },
    { "name": "metadata ok keeps case", "specs": [{ "name": "key", "type": "string", "allow": "metadataKeys" }], "values": ["Hunger"], "ok": true, "params": { "key": "Hunger" } },
    { "name": "location own resource", "specs": [{ "name": "location", "type": "string", "allow": "locations" }], "values": ["pier"], "ok": true, "params": { "location": { "x": -1850.5, "y": -1231.2, "z": 13, "h": 90, "r": 6, "name": "pier" } } },
    { "name": "location falls back to kora_qa", "specs": [{ "name": "location", "type": "string", "allow": "locations" }], "values": ["legion"], "ok": true, "params": { "location": { "x": 195.2, "y": -933.8, "z": 30.7, "h": 144, "name": "legion" } } },
    { "name": "location explicit resource", "specs": [{ "name": "location", "type": "string", "allow": "locations" }], "values": ["kora_hud:hq"], "ok": true, "params": { "location": { "x": 1, "y": 2, "z": 3, "name": "kora_hud:hq" } } },
    { "name": "location array form", "specs": [{ "name": "location", "type": "string", "allow": "locations" }], "values": ["list"], "ok": true, "params": { "location": { "x": 1, "y": 2, "z": 3, "name": "list" } } },
    { "name": "location of another resource not visible", "specs": [{ "name": "location", "type": "string", "allow": "locations" }], "values": ["hq"], "ok": false, "error": "\"hq\" (location) is not a known location alias" },
    { "name": "vehicle alias", "specs": [{ "name": "model", "type": "string", "allow": "vehicles" }], "values": ["boat"], "ok": true, "params": { "model": "dinghy" } },
    { "name": "vehicle alias table", "specs": [{ "name": "model", "type": "string", "allow": "vehicles" }], "values": ["tbl"], "ok": true, "params": { "model": "sultan" } },
    { "name": "vehicle kora_qa alias", "specs": [{ "name": "model", "type": "string", "allow": "vehicles" }], "values": ["cop"], "ok": true, "params": { "model": "police" } },
    { "name": "raw model", "specs": [{ "name": "model", "type": "string", "allow": "vehicles" }], "values": ["Adder"], "ok": true, "params": { "model": "adder" } },
    { "name": "alias resolving to denied model", "specs": [{ "name": "model", "type": "string", "allow": "vehicles" }], "values": ["tank"], "ok": false, "error": "\"tank\" (model) is on the model denylist" },
    { "name": "denied raw model", "specs": [{ "name": "model", "type": "string", "allow": "peds" }], "values": ["Hydra"], "ok": false, "error": "\"Hydra\" (model) is on the model denylist" },
    { "name": "bad model name", "specs": [{ "name": "model", "type": "string", "allow": "props" }], "values": ["prop box"], "ok": false, "error": "\"prop box\" (model) is not a model name or alias" },
    { "name": "ped scenario", "specs": [{ "name": "scenario", "type": "string", "allow": "pedScenarios" }], "values": ["WORLD_HUMAN_SMOKING"], "ok": true, "params": { "scenario": "WORLD_HUMAN_SMOKING" } },
    { "name": "ped scenario lowercase refused", "specs": [{ "name": "scenario", "type": "string", "allow": "pedScenarios" }], "values": ["world_human"], "ok": false, "error": "\"world_human\" (scenario) is not a GTA scenario name" },
    { "name": "weather ok uppercased", "specs": [{ "name": "weather", "type": "string", "allow": "weather" }], "values": ["rain"], "ok": true, "params": { "weather": "RAIN" } },
    { "name": "weather not listed", "specs": [{ "name": "weather", "type": "string", "allow": "weather" }], "values": ["SNOW"], "ok": false, "error": "\"SNOW\" (weather) is not a weather type" },
    { "name": "inventory type", "specs": [{ "name": "type", "type": "string", "allow": "inventoryTypes" }], "values": ["Trunk"], "ok": true, "params": { "type": "trunk" } },
    { "name": "inventory type unknown", "specs": [{ "name": "type", "type": "string", "allow": "inventoryTypes" }], "values": ["safe"], "ok": false, "error": "\"safe\" (type) is not an inventory type" },
    { "name": "fixture", "specs": [{ "name": "fixture", "type": "string", "allow": "fixtures" }], "values": ["ready"], "ok": true, "params": { "fixture": { "name": "ready", "owner": "kora_fishing", "steps": [ { "step": "items.have", "args": [1, "fishingrod"] } ] } } },
    { "name": "fixture unknown", "specs": [{ "name": "fixture", "type": "string", "allow": "fixtures" }], "values": ["nope"], "ok": false, "error": "\"nope\" (fixture) is not a known fixture" },
    { "name": "command with slash", "specs": [{ "name": "command", "type": "string", "allow": "commands" }], "values": ["/ID on"], "ok": true, "params": { "command": { "text": "ID on", "name": "id" } } },
    { "name": "command without slash", "specs": [{ "name": "command", "type": "string", "allow": "commands" }], "values": ["me waves"], "ok": true, "params": { "command": { "text": "me waves", "name": "me" } } },
    { "name": "command bad", "specs": [{ "name": "command", "type": "string", "allow": "commands" }], "values": ["/!rm"], "ok": false, "error": "\"/!rm\" (command) is not a command" },
    { "name": "mark ok", "specs": [{ "name": "mark", "type": "string", "allow": "marks" }], "values": ["fishing:caught fish/1"], "ok": true, "params": { "mark": "fishing:caught fish/1" } },
    { "name": "mark bad chars", "specs": [{ "name": "mark", "type": "string", "allow": "marks" }], "values": ["mark<script>"], "ok": false, "error": "\"mark<script>\" (mark) is not a mark name" },
    { "name": "text anything", "specs": [{ "name": "text", "type": "string", "allow": "text" }], "values": ["This vehicle is locked."], "ok": true, "params": { "text": "This vehicle is locked." } },
    { "name": "unknown allow rule", "specs": [{ "name": "x", "type": "string", "allow": "planets" }], "values": ["mars"], "ok": false, "error": "unknown allow rule planets" },
    { "name": "any maxLength", "specs": [{ "name": "instruction", "type": "any", "maxLength": 5 }], "values": ["do it now"], "ok": false, "error": "instruction is longer than 5 characters" },
    { "name": "argument count", "specs": [{ "name": "a", "type": "string" }], "values": [], "ok": false, "error": "expected 1 argument(s), got 0" },
    { "name": "key alias resolved", "specs": [{ "name": "key", "type": "string", "allow": "keys" }], "values": ["left alt"], "ok": true, "params": { "key": "ALT" } },
    { "name": "key upper-cased, unknown keys allowed", "specs": [{ "name": "key", "type": "string", "allow": "keys" }], "values": [" numpad9 "], "ok": true, "params": { "key": "NUMPAD9" } },
    { "name": "key junk refused", "specs": [{ "name": "key", "type": "string", "allow": "keys" }], "values": ["a;b"], "ok": false, "error": "\"a;b\" (key) is not a key name" },
    { "name": "notify type alias", "specs": [{ "name": "type", "type": "word", "allow": "notifyTypes" }], "values": ["warn"], "ok": true, "params": { "type": "warning" } },
    { "name": "notify type unknown", "specs": [{ "name": "type", "type": "word", "allow": "notifyTypes" }], "values": ["purple"], "ok": false, "error": "\"purple\" (type) is not a notification type (info, success, warning, error)" }
  ],
  "defs": [
    { "name": "valid def", "def": { "id": "items.have", "pattern": "I have {int} {string}", "kind": "setup", "side": "server", "args": [{ "name": "count", "type": "int" }, { "name": "item", "type": "string" }] }, "ok": true },
    { "name": "bad id", "def": { "id": "nodot", "pattern": "x", "kind": "setup", "side": "server", "args": [] }, "ok": false, "error": "id must look like \"group.name\"" },
    { "name": "bad kind", "def": { "id": "a.b", "pattern": "x", "kind": "magic", "side": "server", "args": [] }, "ok": false, "error": "a.b: unknown kind magic" },
    { "name": "bad side", "def": { "id": "a.b", "pattern": "x", "kind": "check", "side": "moon", "args": [] }, "ok": false, "error": "a.b: unknown side moon" },
    { "name": "placeholder count", "def": { "id": "a.b", "pattern": "I have {int}", "kind": "check", "side": "server", "args": [] }, "ok": false, "error": "a.b: pattern has 1 parameters but 0 args" },
    { "name": "bad arg type", "def": { "id": "a.b", "pattern": "I {}", "kind": "manual", "side": "client", "args": [{ "name": "x", "type": "blob" }] }, "ok": false, "error": "a.b: arg 1 malformed" },
    { "name": "priority integer", "def": { "id": "a.b", "pattern": "x", "kind": "check", "side": "server", "priority": 1.5, "args": [] }, "ok": false, "error": "a.b: priority must be an integer" }
  ]
}
